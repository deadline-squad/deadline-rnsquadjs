[Unit]
Description=RNSquadJS (Squad server daemon for squad1)
After=network-online.target docker.service squad1.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/RNSquadJS
ExecStart=/usr/bin/node lib/index.js
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rnsquadjs
AllowedCPUs=6-7,14-15

[Install]
WantedBy=multi-user.target
